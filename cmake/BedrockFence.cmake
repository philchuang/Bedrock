cmake_policy(SET CMP0057 NEW)

# The split is three targets. This is what keeps them three: configure fails
# when a source grows an include it must not have. Comments do not.
#
#   bedrock_rules  no OpenCV, no Win32, no MinerGUI.h
#   bedrock_read   no MinerGUI.h, no ore-table header
#   the executable's window and Application: no reader header that mentions cv::
#     (SelfTest, DevTools, DevShots and main are the developer tools and may)

function(_bedrock_fence_walk file)
    get_property(seen GLOBAL PROPERTY _BEDROCK_FENCE_SEEN)
    if(file IN_LIST seen)
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY _BEDROCK_FENCE_SEEN "${file}")
    if(NOT EXISTS "${file}")
        return()
    endif()
    file(READ "${file}" text)
    string(REGEX MATCHALL "#[ \t]*include[ \t]*[\"<][^\">]+[\">]" hits "${text}")
    foreach(hit IN LISTS hits)
        string(REGEX REPLACE "^.*[\"<]([^\">]+)[\">].*$" "\\1" inc "${hit}")
        get_filename_component(base "${inc}" NAME)
        string(TOLOWER "${base}" base_lower)
        string(TOLOWER "${inc}" inc_lower)
        get_property(names GLOBAL PROPERTY _BEDROCK_FENCE_NAMES)
        foreach(bad IN LISTS names)
            string(TOLOWER "${bad}" bad_lower)
            if(base_lower STREQUAL bad_lower)
                get_property(root GLOBAL PROPERTY _BEDROCK_FENCE_ROOT)
                set_property(GLOBAL APPEND PROPERTY _BEDROCK_FENCE_ERRORS
                    "${root} reaches ${inc} via ${file}")
            endif()
        endforeach()
        get_property(opencv GLOBAL PROPERTY _BEDROCK_FENCE_OPENCV)
        if(opencv AND inc_lower MATCHES "^opencv2/")
            get_property(root GLOBAL PROPERTY _BEDROCK_FENCE_ROOT)
            set_property(GLOBAL APPEND PROPERTY _BEDROCK_FENCE_ERRORS
                "${root} reaches ${inc} via ${file}")
        endif()
        set(found "")
        foreach(dir IN ITEMS "${CMAKE_SOURCE_DIR}/include" "${CMAKE_SOURCE_DIR}/src")
            if(EXISTS "${dir}/${inc}")
                set(found "${dir}/${inc}")
                break()
            endif()
        endforeach()
        # a header beside the file that included it
        if(found STREQUAL "" AND NOT IS_ABSOLUTE "${inc}")
            get_filename_component(here "${file}" DIRECTORY)
            if(EXISTS "${here}/${inc}")
                set(found "${here}/${inc}")
            endif()
        endif()
        if(NOT found STREQUAL "")
            get_property(want_cv GLOBAL PROPERTY _BEDROCK_FENCE_CV)
            if(want_cv)
                file(READ "${found}" body)
                if(body MATCHES "cv::")
                    get_property(root GLOBAL PROPERTY _BEDROCK_FENCE_ROOT)
                    set_property(GLOBAL APPEND PROPERTY _BEDROCK_FENCE_ERRORS
                        "${root} includes ${inc}, which mentions cv::")
                endif()
            endif()
            _bedrock_fence_walk("${found}")
        endif()
    endforeach()
endfunction()

# SOURCES: files to start from. NAMES: header file names that must not appear.
# CV: when TRUE, a project header that mentions cv:: is a failure.
function(bedrock_check_fence label)
    cmake_parse_arguments(ARG "CV;OPENCV" "" "SOURCES;NAMES" ${ARGN})
    set_property(GLOBAL PROPERTY _BEDROCK_FENCE_ERRORS "")
    set_property(GLOBAL PROPERTY _BEDROCK_FENCE_NAMES "${ARG_NAMES}")
    set_property(GLOBAL PROPERTY _BEDROCK_FENCE_CV "${ARG_CV}")
    set_property(GLOBAL PROPERTY _BEDROCK_FENCE_OPENCV "${ARG_OPENCV}")
    foreach(src IN LISTS ARG_SOURCES)
        if(NOT IS_ABSOLUTE "${src}")
            set(src "${CMAKE_SOURCE_DIR}/${src}")
        endif()
        set_property(GLOBAL PROPERTY _BEDROCK_FENCE_SEEN "")
        set_property(GLOBAL PROPERTY _BEDROCK_FENCE_ROOT "${src}")
        _bedrock_fence_walk("${src}")
    endforeach()
    get_property(errors GLOBAL PROPERTY _BEDROCK_FENCE_ERRORS)
    if(errors)
        list(REMOVE_DUPLICATES errors)
        list(JOIN errors "\n  " text)
        message(FATAL_ERROR "${label}:\n  ${text}")
    endif()
endfunction()
